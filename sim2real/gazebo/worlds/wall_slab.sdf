<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wall-and-slab test world for PX4 SITL: a vertical wall (the plane x = 0, structure on the
  +x side, as in envs/structure_hold) and an overhead slab (a bridge underside) at z = 5 m.
  The vehicle spawns 1 to 3 m from the wall (PX4_GZ_MODEL_POSE, set by the scenario runner).

  Physics, scene and coordinates copy PX4's default.sdf so the x500 flies exactly as it does
  there. The StructureHoldWind plugin (sim2real/gazebo/plugin) applies the shared wind and
  near-wall force from envs/disturbance to the vehicle every physics step; its params and
  trace paths come from the STRUCTURE_HOLD_WIND_PARAMS / STRUCTURE_HOLD_WIND_TRACE
  environment variables (see WindAdapter.cc).

  gz-sim loads the default systems from PX4's server.config only when a world declares no
  <plugin> at all, so this world lists the same stock systems explicitly (same set and
  order as src/modules/simulation/gz_bridge/server.config in PX4 v1.17.0, minus the two
  camera systems the x500 does not use) before the wind plugin.
-->
<sdf version="1.9">
  <world name="wall_slab">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="StructureHoldWind" name="structure_hold::WindAdapter">
      <model_name>x500_0</model_name>
      <link_name>base_link</link_name>
      <params>/out/wind_params.txt</params>
      <trace>/out/wind_trace.csv</trace>
      <trace_every>1</trace_every>
      <subtract_still_air_drag>true</subtract_still_air_drag>
      <start_time>0.0</start_time>
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- The structure: wall surface at x = 0 (wall occupies 0 < x < 0.5), slab underside at
         z = 5 reaching 8 m out over the free-air side, both 20 m long along y. -->
    <model name="structure">
      <static>true</static>
      <link name="wall">
        <pose>0.25 0 3.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 20 6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 20 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name="slab">
        <pose>-3.75 0 5.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.5 20 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.5 20 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
