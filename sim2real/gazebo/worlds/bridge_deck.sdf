<?xml version="1.0" encoding="UTF-8"?>
<!--
  Under a bridge deck (docs/bridge-holds.md): an abutment wall (the plane x = 0, structure on
  +x, as in wall_slab) and the deck it carries, its underside the plane z = 4 m, 1 m deep,
  running 14 m out along -x over the free-air side and 20 m wide along y. The bridge's axis
  is x, so a crosswind (wind along y) blows across the deck and sheds vortices from its
  edges. A hold 2.5 m up sits 1.5 m under the deck; spawned 1 m from the abutment it is in
  the corner of both surfaces, spawned 6 m out it is under the deck alone.

  The scenarios place the deck as the wind model's second surface (surface2: point
  [0, 0, 4], normal_toward [0, 0, 1], across [0, 1, 0]), so the plugin shelters the wind
  under it and adds its edge shedding.

  Physics, scene, coordinates, the stock systems and the StructureHoldWind plugin are the
  same as wall_slab.sdf (read its header): only the structure differs, so a flight here and
  one there differ only in the structure and the air the scenario puts round it.
-->
<sdf version="1.9">
  <world name="bridge_deck">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="StructureHoldWind" name="structure_hold::WindAdapter">
      <model_name>x500_0</model_name>
      <link_name>base_link</link_name>
      <params>/out/wind_params.txt</params>
      <trace>/out/wind_trace.csv</trace>
      <trace_every>1</trace_every>
      <subtract_still_air_drag>true</subtract_still_air_drag>
      <start_time>0.0</start_time>
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- The structure: abutment face at x = 0 (abutment occupies 0 < x < 0.5, up to the deck),
         deck from x = -14 to 0.5 with its underside at z = 4, both 20 m along y. -->
    <model name="structure">
      <static>true</static>
      <link name="abutment">
        <pose>0.25 0 2.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 20 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 20 4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name="deck">
        <pose>-6.75 0 4.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>14.5 20 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>14.5 20 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
