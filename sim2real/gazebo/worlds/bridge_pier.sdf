<?xml version="1.0" encoding="UTF-8"?>
<!--
  Beside a bridge pier (docs/bridge-holds.md): one square pier 1.5 m wide, its near face the
  plane x = 0 (pier occupies 0 < x < 1.5, -0.75 < y < 0.75, as wall_slab's wall faces the
  drone), 6 m tall, under a deck 1 m deep that runs 30 m along the bridge's axis y. A hold
  1 m in front of the face with the wind blowing away from it (toward -x) sits in the pier's
  wake, where it sheds vortices at f = St U / D: 0.7 to 1.1 Hz at 8 m/s for St 0.13 to 0.2
  and D = 1.5 m, inside the band the hold loop works in.

  The wind model treats the face as an infinite plane (every term depends on the distance
  from it); the scenarios set the shedding width to the pier's 1.5 m. The deck is 3.5 m
  above a 2.5 m hold, where its shelter would be a few per cent at most, so the pier
  scenarios leave it out of the wind model. The forward rangefinder of the estimate bridge
  sees the face as a plane too: it would read past the pier's edge past |y| = 0.75 m, which
  a hold that drifts that far sideways has failed anyway.

  Physics, scene, coordinates, the stock systems and the StructureHoldWind plugin are the
  same as wall_slab.sdf (read its header): only the structure differs, so a flight here and
  one there differ only in the structure and the air the scenario puts round it.
-->
<sdf version="1.9">
  <world name="bridge_pier">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="StructureHoldWind" name="structure_hold::WindAdapter">
      <model_name>x500_0</model_name>
      <link_name>base_link</link_name>
      <params>/out/wind_params.txt</params>
      <trace>/out/wind_trace.csv</trace>
      <trace_every>1</trace_every>
      <subtract_still_air_drag>true</subtract_still_air_drag>
      <start_time>0.0</start_time>
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- The structure: a square pier, face at x = 0, 1.5 m on a side and 6 m tall, under a deck
         (z = 6 to 7) 8 m wide along x and 30 m long along y. -->
    <model name="structure">
      <static>true</static>
      <link name="pier">
        <pose>0.75 0 3.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name="deck">
        <pose>0.75 0 6.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8 30 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 30 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
